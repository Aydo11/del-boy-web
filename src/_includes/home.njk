---
layout: base.njk
---
{% import "partials/mock-screens.njk" as mocks %}
{% set shown = [] %}
{% for s in screens %}{% if s.image or s.mock %}{% set shown = (shown.push(s), shown) %}{% endif %}{% endfor %}

{# ── A. HERO ─────────────────────────────────────────── #}
<section class="hero{% if hero.theme == 'red' %} hero--red{% endif %}" aria-labelledby="hero-title" data-hero>
  <div class="hero-ambient" aria-hidden="true">
    <span class="blob blob-1"></span><span class="blob blob-2"></span>
    <img class="hero-mark" src="/assets/img/icon-white.svg" alt="" width="640" height="640">
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow rise" style="--d:0">{{ hero.eyebrow }}</p>
      <h1 id="hero-title">{% for l in hero.headline.split("<br>") %}<span class="line"><span class="line-in" style="--d:{{ loop.index }}">{{ l | safe }}</span></span>{% endfor %}</h1>
      <p class="lede rise" style="--d:3">{{ hero.text }}</p>
      <div class="rise" style="--d:4">{% set ctaLocation = "hero" %}{% include "partials/store.njk" %}</div>
    </div>

    <div class="hero-visual">
      <div class="spotlight" aria-hidden="true"></div>
      <div class="phone-stage" data-phone>
        <div class="phone-tilt" data-tilt>
        <div class="phone">
          <div class="phone-screen" aria-live="off">
            {% if shown.length %}
              {% for s in shown %}
              <figure class="screen{% if loop.first %} is-active{% endif %}" data-screen="{{ loop.index0 }}" {% if not loop.first %}aria-hidden="true"{% endif %}>
                {% set eager = loop.first %}{% include "partials/screen.njk" %}
              </figure>
              {% endfor %}
            {% else %}
              <figure class="screen is-active splash"><img src="/assets/img/icon-red.svg" alt="DEL-BOY® app icon" width="120" height="120"></figure>
            {% endif %}
          </div>
        </div>
        </div>

        <div class="float-card fc-1" aria-hidden="true">
          <span class="fc-icon fc-cal"></span>
          <span><b>Instant jobs</b><i>Pop up live on the map</i></span>
        </div>
        <div class="float-card fc-2" aria-hidden="true">
          <span class="fc-icon fc-pin"></span>
          <span><b>Need a hand?</b><i>Post a job</i></span>
        </div>
      </div>

      {% if shown.length > 1 %}
      <div class="phone-controls" role="group" aria-label="App screens">
        {% for s in shown %}
        <button type="button" class="screen-dot" data-go="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">
          <span class="visually-hidden">Show screen: </span>{{ s.title }}
        </button>
        {% endfor %}
        <button type="button" class="play-toggle" data-toggle aria-pressed="false" hidden>
          <span class="visually-hidden">Pause screen slideshow</span><span class="pp" aria-hidden="true"></span>
        </button>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if highlights %}
{% set icons = {
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  pound: '<path d="M17 7.5A4 4 0 0 0 9 9v11M6 20h12M6 13h8"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 3 8.4 7 10 4-1.6 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  percent: '<path d="M19 5 5 19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/>',
  home: '<path d="M4 11 12 4l8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-5h4v5"/>'
} %}
<section class="highlights" aria-labelledby="hl-title" data-carousel>
  <div class="wrap hl-head">
    <h2 id="hl-title" class="section-title">{{ highlights.title }}</h2>
    <div class="hl-controls">
      <button type="button" class="hl-btn" data-prev aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button type="button" class="hl-btn" data-next aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <ul class="hl-track" role="list" tabindex="0" aria-label="{{ highlights.title }}">
    {% for h in highlights.items %}
    <li class="hl-card hl-card-{{ loop.index }}">
      <span class="hl-num" aria-hidden="true">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
      <span class="hl-icon" aria-hidden="true"><svg viewBox="0 0 24 24">{{ icons[h.icon] | safe }}</svg></span>
      <h3>{{ h.title }}</h3>
      <p>{{ h.text }}</p>
    </li>
    {% endfor %}
  </ul>
  <div class="wrap"><div class="hl-progress" aria-hidden="true"><span></span></div></div>
</section>
{% endif %}

{# ── B. TWO WAYS ─────────────────────────────────────── #}
<section class="section audiences" aria-labelledby="ways-title">
  <div class="wrap">
    <h2 id="ways-title" class="section-title reveal">Two ways to use DEL-BOY®</h2>
    <div class="audience-grid">
      {% for a in audiences %}
      <article id="{{ a.id }}" class="audience-card audience-{{ loop.index }} reveal">
        <div class="audience-copy">
          <p class="eyebrow">{{ a.label }}</p>
          <h3>{{ a.title }}</h3>
          <p>{{ a.text }}</p>
          <a class="text-link" href="{{ a.link }}">{{ a.linkText }} <span aria-hidden="true">→</span></a>
        </div>
        {% for s in shown %}{% if s.id == a.screen %}
        <div class="mini-phone">{% set eager = false %}{% include "partials/screen.njk" %}</div>
        {% endif %}{% endfor %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ── C. HOW IT WORKS ─────────────────────────────────── #}
<section id="how-it-works" class="section how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="section-title reveal">How it works</h2>
    <div class="steps-grid">
      <div class="steps reveal" id="steps-workers">
        <h3>If you're looking for work</h3>
        <ol>
          {% for st in steps.workers %}
          <li><span class="step-num" aria-hidden="true">{{ loop.index }}</span><div><h4>{{ st.title }}</h4><p>{{ st.text }}</p></div></li>
          {% endfor %}
        </ol>
      </div>
      <div class="steps steps-alt reveal" id="steps-posters">
        <h3>If you need someone for a job</h3>
        <ol>
          {% for st in steps.posters %}
          <li><span class="step-num" aria-hidden="true">{{ loop.index }}</span><div><h4>{{ st.title }}</h4><p>{{ st.text }}</p></div></li>
          {% endfor %}
        </ol>
      </div>
    </div>
  </div>
</section>

{# ── D. WALKTHROUGH ──────────────────────────────────── #}
{% if shown.length %}
<section class="section walkthrough" aria-labelledby="walk-title">
  <div class="wrap">
    <h2 id="walk-title" class="section-title reveal">{{ walkthrough.title }}</h2>
    <p class="section-lede reveal">{{ walkthrough.text }}</p>
    <ul class="walk-row" role="list">
      {% for s in shown %}
      <li class="walk-item reveal">
        <div class="mini-phone">{% set eager = false %}{% include "partials/screen.njk" %}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.caption }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{# ── E. QUICK QUESTIONS ──────────────────────────────── #}
<section class="section faq-home" aria-labelledby="faq-title">
  <div class="wrap narrow">
    <h2 id="faq-title" class="section-title reveal">{{ faqTitle or "Instant questions" }}</h2>
    <div class="faq-list">
      {% for f in faqs %}
      <details class="faq">
        <summary>{{ f.q }}</summary>
        <div class="faq-a"><p>{{ f.a | mdi | safe }}</p></div>
      </details>
      {% endfor %}
    </div>
    <p class="more-help"><a class="text-link" href="/support/">More answers on the Support page <span aria-hidden="true">→</span></a></p>
  </div>
</section>

{# ── WhatsApp community ─────────────────────────────── #}
{% if community and site.whatsapp.groupUrl %}
<section class="section community" aria-labelledby="community-title">
  <div class="wrap community-card reveal">
    <div class="community-copy">
      <p class="eyebrow">WhatsApp community</p>
      <h2 id="community-title">{{ community.title }}</h2>
      <p>{{ community.text }}</p>
      <div class="community-actions">
        <a class="btn btn-wa" href="{{ site.whatsapp.groupUrl }}" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2Z"/></svg>
          {{ community.button }}
        </a>
        {% if site.whatsapp.number %}<a class="text-link" href="https://wa.me/{{ site.whatsapp.number }}" rel="noopener">Message us on WhatsApp <span aria-hidden="true">→</span></a>{% endif %}
      </div>
    </div>
    <figure class="community-qr">
      <img src="/assets/img/whatsapp-qr.svg" alt="QR code to join the DEL-BOY® WhatsApp community group" width="220" height="220" loading="lazy">
      <figcaption>Scan with your phone camera</figcaption>
    </figure>
  </div>
</section>
{% endif %}

{# ── F. FINAL DOWNLOAD ───────────────────────────────── #}
<section class="final" aria-labelledby="final-title">
  <div class="wrap final-inner">
    <img class="final-icon" src="/assets/img/icon-red.svg" alt="" width="72" height="72" loading="lazy">
    <h2 id="final-title">{{ final.title }}</h2>
    <p>{{ final.text }}</p>
    {% set ctaLocation = "final" %}{% include "partials/store.njk" %}
    {% if final.credit %}<p class="final-credit">{{ final.credit }}</p>{% endif %}
  </div>
</section>
