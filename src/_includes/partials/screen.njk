{# Renders one app screen: approved screenshot, else preview-only mock. Expects `s`. #}
{% if s.image %}
<img src="{{ s.image }}" alt="{{ s.alt }}" width="390" height="844" {% if eager %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
{% elif build.preview and s.mock %}
<span class="visually-hidden">{{ s.alt }} (illustrative preview)</span>
{{ mocks.mock(s.mock) }}
{% endif %}
